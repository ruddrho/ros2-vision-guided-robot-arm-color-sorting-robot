<?xml version="1.0"?>
<robot name="educational_6dof_arm">
  <material name="dark_gray">
    <color rgba="0.08 0.10 0.12 1.0"/>
  </material>
  <material name="robot_blue">
    <color rgba="0.34 0.38 0.41 1.0"/>
  </material>
  <material name="robot_orange">
    <color rgba="0.92 0.58 0.03 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.55 0.59 0.62 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.11" length="0.08"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <link name="joint_1_rotor">
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.18"/></geometry>
      <material name="robot_blue"/>
    </visual>
    <visual>
      <geometry><sphere radius="0.072"/></geometry>
      <material name="robot_orange"/>
    </visual>
  </link>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="joint_1_rotor"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="50" velocity="1.5"/>
  </joint>

  <link name="link_1"/>
  <joint name="joint_1_dh_fixed" type="fixed">
    <parent link="joint_1_rotor"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
  </joint>

  <link name="joint_2_rotor">
    <visual>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.055 0.055"/></geometry>
      <material name="robot_blue"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.068" length="0.09"/></geometry>
      <material name="robot_orange"/>
    </visual>
  </link>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="joint_2_rotor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.35" upper="2.35" effort="50" velocity="1.5"/>
  </joint>

  <link name="link_2"/>
  <joint name="joint_2_dh_fixed" type="fixed">
    <parent link="joint_2_rotor"/>
    <child link="link_2"/>
    <origin xyz="0.32 0 0" rpy="0 0 0"/>
  </joint>

  <link name="joint_3_rotor">
    <visual>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry><box size="0.28 0.05 0.05"/></geometry>
      <material name="silver"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.062" length="0.085"/></geometry>
      <material name="robot_orange"/>
    </visual>
  </link>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="joint_3_rotor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.35" upper="2.35" effort="50" velocity="1.5"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.22"/></geometry>
      <material name="robot_blue"/>
    </visual>
  </link>
  <joint name="joint_3_dh_fixed" type="fixed">
    <parent link="joint_3_rotor"/>
    <child link="link_3"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
  </joint>

  <link name="joint_4_rotor">
    <visual>
      <geometry><sphere radius="0.058"/></geometry>
      <material name="robot_orange"/>
    </visual>
  </link>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="joint_4_rotor"/>
    <origin xyz="0 0 0.22" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="30" velocity="2.0"/>
  </joint>

  <link name="link_4"/>
  <joint name="joint_4_dh_fixed" type="fixed">
    <parent link="joint_4_rotor"/>
    <child link="link_4"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
  </joint>

  <link name="joint_5_rotor">
    <visual>
      <geometry><cylinder radius="0.05" length="0.075"/></geometry>
      <material name="silver"/>
    </visual>
  </link>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="joint_5_rotor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.50" upper="2.50" effort="20" velocity="2.0"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.032" length="0.10"/></geometry>
      <material name="robot_blue"/>
    </visual>
  </link>
  <joint name="joint_5_dh_fixed" type="fixed">
    <parent link="joint_5_rotor"/>
    <child link="link_5"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 0"/>
  </joint>

  <link name="joint_6_rotor">
    <visual>
      <geometry><cylinder radius="0.042" length="0.06"/></geometry>
      <material name="robot_orange"/>
    </visual>
  </link>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="joint_6_rotor"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="15" velocity="2.5"/>
  </joint>

  <link name="tool0">
    <visual>
      <origin xyz="0.035 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry><cylinder radius="0.022" length="0.07"/></geometry>
      <material name="dark_gray"/>
    </visual>
  </link>
  <joint name="tool_fixed" type="fixed">
    <parent link="joint_6_rotor"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
