<?xml version="1.0"?>
<sdf version="1.10">
  <world name="pick_place">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="key_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.25 -1.0</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><box><size>4 4 0.02</size></box></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><box><size>4 4 0.02</size></box></geometry>
          <material><ambient>0.10 0.12 0.14 1</ambient><diffuse>0.13 0.15 0.17 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="source_table">
      <static>true</static>
      <pose>0.31 -0.31 0.055 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision"><geometry><box><size>0.44 0.44 0.10</size></box></geometry></collision>
        <visual name="top_visual">
          <geometry><box><size>0.44 0.44 0.10</size></box></geometry>
          <material><ambient>0.18 0.22 0.26 1</ambient><diffuse>0.22 0.26 0.30 1</diffuse></material>
        </visual>
        <visual name="front_safety_stripe">
          <pose>0.0 -0.216 0.02 0 0 0</pose>
          <geometry><box><size>0.52 0.008 0.04</size></box></geometry>
          <material><ambient>0.95 0.62 0.04 1</ambient><diffuse>0.95 0.62 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="destination_table">
      <static>true</static>
      <pose>0.31 0.31 0.055 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision"><geometry><box><size>0.44 0.44 0.10</size></box></geometry></collision>
        <visual name="top_visual">
          <geometry><box><size>0.44 0.44 0.10</size></box></geometry>
          <material><ambient>0.18 0.22 0.26 1</ambient><diffuse>0.22 0.26 0.30 1</diffuse></material>
        </visual>
        <visual name="front_safety_stripe">
          <pose>0.0 0.216 0.02 0 0 0</pose>
          <geometry><box><size>0.52 0.008 0.04</size></box></geometry>
          <material><ambient>0.95 0.62 0.04 1</ambient><diffuse>0.95 0.62 0.04 1</diffuse></material>
        </visual>
        <visual name="white_slot"><pose>-0.146 0.139 0.052 0 0 0</pose><geometry><cylinder><radius>0.030</radius><length>0.004</length></cylinder></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="red_slot"><pose>-0.053 0.093 0.052 0 0 0</pose><geometry><cylinder><radius>0.030</radius><length>0.004</length></cylinder></geometry><material><ambient>0.65 0.02 0.02 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual>
        <visual name="blue_slot"><pose>0.028 0.028 0.052 0 0 0</pose><geometry><cylinder><radius>0.030</radius><length>0.004</length></cylinder></geometry><material><ambient>0.02 0.15 0.65 1</ambient><diffuse>0.03 0.25 0.95 1</diffuse></material></visual>
        <visual name="yellow_slot"><pose>0.093 -0.053 0.052 0 0 0</pose><geometry><cylinder><radius>0.030</radius><length>0.004</length></cylinder></geometry><material><ambient>0.85 0.62 0.01 1</ambient><diffuse>1 0.82 0.02 1</diffuse></material></visual>
        <visual name="green_slot"><pose>0.139 -0.146 0.052 0 0 0</pose><geometry><cylinder><radius>0.030</radius><length>0.004</length></cylinder></geometry><material><ambient>0.02 0.45 0.10 1</ambient><diffuse>0.03 0.72 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="overhead_camera">
      <static>true</static>
      <pose>0.30 0 1.55 0 0 0</pose>
      <link name="camera_link">
        <visual name="housing">
          <geometry><box><size>0.10 0.07 0.05</size></box></geometry>
          <material><ambient>0.04 0.05 0.06 1</ambient><diffuse>0.06 0.07 0.08 1</diffuse></material>
        </visual>
        <visual name="lens">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.04 0.16 0.24 1</ambient><diffuse>0.05 0.22 0.32 1</diffuse></material>
        </visual>
        <sensor name="overhead_rgb_camera" type="camera">
          <pose>0 0 0 0 1.57079632679 0</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/overhead_camera/image</topic>
          <camera>
            <horizontal_fov>1.20</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="white_cube">
      <pose>0.153 -0.419 0.125 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.04</mass><inertia><ixx>0.000010667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000010667</iyy><iyz>0</iyz><izz>0.000010667</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>30</update_frequency></plugin>
    </model>

    <model name="red_cube">
      <pose>0.240 -0.376 0.125 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.04</mass><inertia><ixx>0.000010667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000010667</iyy><iyz>0</iyz><izz>0.000010667</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.78 0.03 0.03 1</ambient><diffuse>0.90 0.04 0.04 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>30</update_frequency></plugin>
    </model>

    <model name="blue_cube">
      <pose>0.315 -0.315 0.125 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.04</mass><inertia><ixx>0.000010667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000010667</iyy><iyz>0</iyz><izz>0.000010667</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.02 0.18 0.75 1</ambient><diffuse>0.03 0.24 0.92 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>30</update_frequency></plugin>
    </model>

    <model name="yellow_cube">
      <pose>0.376 -0.240 0.125 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.04</mass><inertia><ixx>0.000010667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000010667</iyy><iyz>0</iyz><izz>0.000010667</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.92 0.70 0.02 1</ambient><diffuse>1.0 0.82 0.03 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>30</update_frequency></plugin>
    </model>

    <model name="green_cube">
      <pose>0.419 -0.153 0.125 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.04</mass><inertia><ixx>0.000010667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000010667</iyy><iyz>0</iyz><izz>0.000010667</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.02 0.55 0.12 1</ambient><diffuse>0.03 0.72 0.18 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>30</update_frequency></plugin>
    </model>
  </world>
</sdf>
